{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadOnlySecureGalleryObject",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": "arn:aws:s3:::lab14-secure-media-006604850061/gallery/*"
    },
    {
      "Sid": "DecryptOnlyForS3",
      "Effect": "Allow",
      "Action": ["kms:Decrypt", "kms:DescribeKey"],
      "Resource": "arn:aws:kms:us-east-2:006604850061:key/e9e0faa5-b5ab-4e2e-8862-3b20d743b783",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "s3.us-east-2.amazonaws.com"
        }
      }
    }
  ]
}

